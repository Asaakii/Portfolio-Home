---
import type { ArchNode } from '../data/projects';

interface Props {
  nodes: ArchNode[];
  subtitle?: string;
}

const { nodes, subtitle } = Astro.props;
const lastIdx = nodes.length - 1;
---

<div data-pipeline data-step-count={nodes.length} class="rounded-2xl border border-gray-100 bg-white/80 p-5 backdrop-blur-sm">
  <div class="mb-0.5 flex items-center justify-between gap-3">
    <div class="text-[10px] uppercase tracking-[2px] text-gray-300">
      Pipeline
    </div>
    <button
      type="button"
      data-pipeline-toggle
      class="flex h-6 items-center gap-1.5 rounded-full border border-gray-200 bg-white px-2 text-[9px] text-gray-400 transition hover:border-gray-300 hover:text-gray-700"
      aria-label="暂停流程演示"
      title="暂停流程演示"
    >
      <span data-pipeline-toggle-icon aria-hidden="true">Ⅱ</span>
      <span data-pipeline-toggle-label>自动演示</span>
    </button>
  </div>
  {subtitle && (
    <div class="mb-3 text-[10px] text-gray-400">{subtitle}</div>
  )}
  {!subtitle && <div class="mb-3" />}

  <!-- Mobile: compact 2-col grid -->
  <div class="grid grid-cols-2 gap-1.5 md:hidden">
    {
      nodes.map((node, i) => (
        <button
          type="button"
          data-pipeline-node
          data-step-index={i}
          data-step-label={node.label}
          data-step-sub={node.sub || ''}
          aria-current={i === 0 ? 'step' : undefined}
          class:list={[
            'pipeline-node rounded-md border px-3 py-2 text-center',
            i === 0 && 'is-active',
          ]}
          style={`background-color: ${node.color}; border-color: rgba(0,0,0,0.05);`}
        >
          <div class:list={[
            'text-[10px] font-medium',
            i === lastIdx ? 'text-gray-900' : 'text-gray-700',
          ]}>
            {node.label}
          </div>
        </button>
      ))
    }
  </div>

  <!-- Desktop: vertical flow with connectors -->
  <div class="hidden flex-col items-stretch gap-0 md:flex">
    {
      nodes.map((node, i) => (
        <>
          <button
            type="button"
            data-pipeline-node
            data-step-index={i}
            data-step-label={node.label}
            data-step-sub={node.sub || ''}
            aria-current={i === 0 ? 'step' : undefined}
            class:list={[
              'pipeline-node rounded-lg border px-4 py-2.5 text-left',
              i === 0 && 'is-active',
            ]}
            style={`background-color: ${node.color}; border-color: rgba(0,0,0,0.05);`}
          >
            <div class:list={[
              'text-[11px] font-medium',
              i === lastIdx ? 'text-gray-900' : 'text-gray-700',
            ]}>
              {node.label}
            </div>
            {node.sub && (
              <div class="mt-0.5 text-[9px] text-gray-400">{node.sub}</div>
            )}
          </button>
          {i < lastIdx && (
            <div class="flex justify-center">
              <div data-pipeline-connector data-after-index={i} class="pipeline-connector h-2.5 w-px bg-gray-200" />
            </div>
          )}
        </>
      ))
    }
  </div>

  <div class="mt-3 rounded-lg border border-gray-100 bg-gray-50/80 px-3 py-2.5">
    <div class="flex items-center gap-2 text-[9px] uppercase tracking-[1.5px] text-gray-400">
      <span data-pipeline-position class="font-medium text-indigo-500">01 / {String(nodes.length).padStart(2, '0')}</span>
      <span>当前阶段</span>
    </div>
    <div class="mt-1 flex items-baseline gap-2">
      <span data-pipeline-label class="text-[11px] font-medium text-gray-800">{nodes[0]?.label}</span>
      <span data-pipeline-sub class="truncate text-[9px] text-gray-400">{nodes[0]?.sub}</span>
    </div>
    <div class="mt-2 h-0.5 overflow-hidden rounded-full bg-gray-200/70">
      <div data-pipeline-progress class="h-full origin-left rounded-full bg-indigo-400 transition-[width] duration-500" style={`width: ${100 / nodes.length}%`} />
    </div>
  </div>
</div>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-pipeline]').forEach((pipeline) => {
    const nodes = Array.from(pipeline.querySelectorAll<HTMLButtonElement>('[data-pipeline-node]'));
    const connectors = Array.from(pipeline.querySelectorAll<HTMLElement>('[data-pipeline-connector]'));
    const toggle = pipeline.querySelector<HTMLButtonElement>('[data-pipeline-toggle]');
    const toggleIcon = pipeline.querySelector<HTMLElement>('[data-pipeline-toggle-icon]');
    const toggleLabel = pipeline.querySelector<HTMLElement>('[data-pipeline-toggle-label]');
    const position = pipeline.querySelector<HTMLElement>('[data-pipeline-position]');
    const label = pipeline.querySelector<HTMLElement>('[data-pipeline-label]');
    const sub = pipeline.querySelector<HTMLElement>('[data-pipeline-sub]');
    const progress = pipeline.querySelector<HTMLElement>('[data-pipeline-progress]');
    const stepCount = Number(pipeline.dataset.stepCount || 1);
    let activeIndex = 0;
    let timer: number | undefined;
    let isPlaying = !prefersReducedMotion.matches;
    let isInView = true;

    const render = () => {
      nodes.forEach((node) => {
        const isActive = Number(node.dataset.stepIndex) === activeIndex;
        node.classList.toggle('is-active', isActive);
        if (isActive) node.setAttribute('aria-current', 'step');
        else node.removeAttribute('aria-current');
      });
      connectors.forEach((connector) => {
        connector.classList.toggle('is-complete', Number(connector.dataset.afterIndex) < activeIndex);
      });

      const activeNode = nodes.find((node) => Number(node.dataset.stepIndex) === activeIndex);
      if (position) position.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(stepCount).padStart(2, '0')}`;
      if (label) label.textContent = activeNode?.dataset.stepLabel || '';
      if (sub) sub.textContent = activeNode?.dataset.stepSub || '';
      if (progress) progress.style.width = `${((activeIndex + 1) / stepCount) * 100}%`;
      if (toggle) {
        toggle.setAttribute('aria-label', isPlaying ? '暂停流程演示' : '继续流程演示');
        toggle.title = isPlaying ? '暂停流程演示' : '继续流程演示';
      }
      if (toggleIcon) toggleIcon.textContent = isPlaying ? 'Ⅱ' : '▶';
      if (toggleLabel) toggleLabel.textContent = isPlaying ? '自动演示' : '已暂停';
    };

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (!isPlaying || !isInView || stepCount < 2) return;
      timer = window.setInterval(() => {
        activeIndex = (activeIndex + 1) % stepCount;
        render();
      }, 1800);
    };

    nodes.forEach((node) => {
      node.addEventListener('click', () => {
        activeIndex = Number(node.dataset.stepIndex || 0);
        isPlaying = false;
        stop();
        render();
      });
    });

    toggle?.addEventListener('click', () => {
      isPlaying = !isPlaying;
      render();
      start();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        isInView = entries[0]?.isIntersecting ?? true;
        if (isInView) start();
        else stop();
      }, { threshold: 0.12 });
      observer.observe(pipeline);
    }

    render();
    start();
  });
</script>

<style>
  .pipeline-node {
    cursor: pointer;
    opacity: 0.68;
    transition:
      opacity 240ms ease,
      transform 240ms ease,
      box-shadow 240ms ease,
      border-color 240ms ease;
  }

  .pipeline-node:hover {
    opacity: 0.9;
  }

  .pipeline-node.is-active {
    z-index: 1;
    opacity: 1;
    transform: translateY(-1px) scale(1.012);
    border-color: rgba(99, 102, 241, 0.32) !important;
    box-shadow:
      0 0 0 2px rgba(99, 102, 241, 0.1),
      0 6px 16px rgba(15, 23, 42, 0.08);
  }

  .pipeline-node:focus-visible {
    outline: 2px solid rgba(99, 102, 241, 0.55);
    outline-offset: 2px;
  }

  .pipeline-connector {
    transition: background-color 300ms ease, box-shadow 300ms ease;
  }

  .pipeline-connector.is-complete {
    background-color: rgb(129 140 248);
    box-shadow: 0 0 7px rgba(99, 102, 241, 0.65);
  }

  @media (prefers-reduced-motion: reduce) {
    .pipeline-node,
    .pipeline-connector {
      transition: none;
    }

    .pipeline-node.is-active {
      transform: none;
    }
  }
</style>
