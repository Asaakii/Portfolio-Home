---
import Layout from './Layout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import MetricsGrid from '../components/MetricsGrid.astro';
import TechTags from '../components/TechTags.astro';
import HeroPipeline from '../components/HeroPipeline.astro';
import FadeIn from '../components/FadeIn.astro';
import { getProject, getAdjacentProjects } from '../data/projects';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const project = getProject(slug)!;
const { prev, next } = getAdjacentProjects(slug);

const pipelineSubtitles: Record<string, string> = {
  'county-agent': 'County Agent · 从资料接收到报告交付',
  'ai-assistant': 'RAG Pipeline · 从提问到溯源回答',
  'smart-platform': 'Integration · 从子系统到统一大屏',
  'data-collection': 'IoT Pipeline · 从设备到可视化',
};

const sectionNav = [
  project.outcomes?.length && { id: 'outcomes', label: '成果' },
  project.background && { id: 'background', label: '背景' },
  project.painPoints?.length && { id: 'challenges', label: '挑战' },
  slug === 'county-agent' && { id: 'architecture-overview', label: '总体架构' },
  project.implementationPath && { id: 'implementation', label: '实施路径' },
  project.runtimeCase && { id: 'runtime-case', label: '实战链路' },
  project.dataAssets?.length && { id: 'data-foundation', label: '数据底座' },
  project.engineeringMethods && { id: 'engineering-methods', label: '知识工程' },
  project.expertRoles?.length && { id: 'expert-roles', label: '专家角色' },
  project.screenshots?.length && { id: 'screenshots', label: '项目截图' },
  { id: 'highlights', label: '核心亮点' },
].filter(Boolean) as { id: string; label: string }[];
---

<Layout title={`${project.title} — Asaakii`} showBack>
  <main class="mx-auto max-w-5xl px-6 md:px-10">

    <!-- Hero: 2-col on desktop, pipeline on right -->
    <FadeIn>
      <section id="overview" class="grid scroll-mt-28 items-start gap-8 pb-10 pt-16 md:grid-cols-5 md:items-stretch md:gap-12 md:pt-20">
        <div class="flex flex-col md:col-span-3">
          <div class="mb-3 text-[10px] uppercase tracking-[2px] text-gray-400">
            {project.company} · {project.period}
          </div>
          <h1 class="mb-5 text-2xl font-light leading-snug text-gray-900 md:text-3xl">
            {project.title}
          </h1>
          <p class="text-sm leading-[1.8] text-gray-600">
            {project.summary}
          </p>
          {slug === 'county-agent' && (
            <button
              type="button"
              data-lightbox="https://img-asaakii-top.oss-cn-shanghai.aliyuncs.com/img/Codex%20%E5%9B%BE%E5%83%8F%202026%E5%B9%B49%E6%9C%8814%E6%97%A5%2000_30_57.webp"
              data-alt="县域经济智能决策支撑平台总体工作流与底座支撑架构图"
              aria-label="放大查看县域经济智能决策支撑平台总体架构图"
              class="group mt-8 block w-full cursor-zoom-in overflow-hidden rounded-xl border border-slate-800/10 bg-[#052d63] text-left shadow-sm transition-shadow hover:shadow-md md:mt-10"
            >
              <img
                src="https://img-asaakii-top.oss-cn-shanghai.aliyuncs.com/img/Codex%20%E5%9B%BE%E5%83%8F%202026%E5%B9%B49%E6%9C%8814%E6%97%A5%2000_30_57.webp"
                alt="县域经济智能决策支撑平台总体工作流与底座支撑架构图"
                class="block h-auto w-full transition-transform duration-300 group-hover:scale-[1.01]"
                width="1672"
                height="941"
                loading="eager"
                fetchpriority="high"
              />
            </button>
          )}
        </div>
        <div class="md:col-span-2">
          <HeroPipeline nodes={project.architecture} subtitle={pipelineSubtitles[slug]} />
        </div>
      </section>
    </FadeIn>

    <!-- Metrics -->
    <FadeIn>
      <section class="pb-10">
        <MetricsGrid metrics={project.metrics} />
      </section>
    </FadeIn>

    <nav data-section-nav aria-label="项目章节导航" class="sticky top-[65px] z-40 -mx-2 mb-10 flex gap-1.5 overflow-x-auto rounded-xl border border-gray-200/80 bg-white/90 p-2 shadow-sm backdrop-blur-md [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {sectionNav.map((item, index) => (
        <a
          href={`#${item.id}`}
          data-section-link={item.id}
          class:list={[
            'section-nav-link flex-none rounded-lg px-3 py-1.5 text-[10px] font-medium transition-colors',
            index === 0 ? 'is-active' : 'text-gray-400 hover:bg-gray-50 hover:text-gray-700',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Outcomes: right after metrics, prominent style -->
    {project.outcomes && project.outcomes.length > 0 && (
      <FadeIn delay={0.05}>
        <section id="outcomes" data-page-section class="scroll-mt-28 mb-10 rounded-2xl bg-gray-50 px-6 py-6 md:px-8 md:py-8">
          <SectionLabel text="Project Outcomes" />
          <ul class="space-y-3">
            {project.outcomes.map((item) => (
              <li class="flex items-start gap-3 text-sm leading-[1.8] text-gray-700 [&_strong]:font-semibold [&_strong]:text-gray-900">
                <span class="mt-[10px] block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gray-400" />
                <span set:html={item} />
              </li>
            ))}
          </ul>
        </section>
      </FadeIn>
    )}

    <!-- Background -->
    {project.background && (
      <FadeIn delay={0.08}>
        <section id="background" data-page-section class="scroll-mt-28 pb-10">
          <SectionLabel text="Project Background" />
          <p class="max-w-3xl text-sm leading-[1.9] text-gray-700">
            {project.background}
          </p>
        </section>
      </FadeIn>
    )}

    <!-- Pain Points -->
    {project.painPoints && project.painPoints.length > 0 && (
      <FadeIn delay={0.1}>
        <section id="challenges" data-page-section class="scroll-mt-28 pb-10">
          <SectionLabel text="Core Challenges" />
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {project.painPoints.map((point) => (
              <details open class="group rounded-xl border border-red-100 bg-red-50/50 px-5 py-4 transition-all open:border-red-200 open:bg-red-50 hover:border-red-200 hover:shadow-sm">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 [&::-webkit-details-marker]:hidden">
                  <div class="flex items-center gap-2">
                  <span class="flex h-6 w-6 items-center justify-center rounded-full bg-red-100 text-xs text-red-600">!</span>
                  <span class="text-[13px] font-semibold text-gray-900">{point.title}</span>
                  </div>
                  <span class="text-base font-light text-red-300 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <div class="grid grid-rows-[0fr] transition-all duration-300 group-open:grid-rows-[1fr]">
                  <div class="overflow-hidden">
                    <p class="pt-3 text-[12px] leading-[1.7] text-gray-600">{point.description}</p>
                  </div>
                </div>
              </details>
            ))}
          </div>
        </section>
      </FadeIn>
    )}

    <!-- Solution Positioning -->
    {project.solutionPositioning && (
      <FadeIn delay={0.12}>
        <section class="mb-10 rounded-2xl border border-indigo-100 bg-indigo-50/40 px-6 py-6 md:px-8 md:py-8">
          <SectionLabel text="Solution & Positioning" />
          <p class="text-sm leading-[1.9] text-gray-700">{project.solutionPositioning}</p>
        </section>
      </FadeIn>
    )}

    <!-- County Agent controlled workflow overview -->
    {slug === 'county-agent' && (
      <FadeIn delay={0.12}>
        <section id="architecture-overview" data-page-section class="scroll-mt-36 mb-10 pt-2">
          <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
            <div>
              <SectionLabel text="受控工作流总体架构" />
              <p class="max-w-2xl text-[12px] leading-[1.75] text-gray-500">
                从任务受理、业务 SOP 路由到 SQL / RAG 证据融合、质量门禁与多格式交付的完整技术架构。
              </p>
            </div>
            <span class="rounded-full border border-blue-100 bg-blue-50 px-3 py-1 text-[9px] font-medium text-blue-600">点击图片放大查看</span>
          </div>
          <button
            type="button"
            data-lightbox="https://img-asaakii-top.oss-cn-shanghai.aliyuncs.com/img/Codex%20%E5%9B%BE%E5%83%8F%202026%E5%B9%B49%E6%9C%8814%E6%97%A5%2000_31_17.webp"
            data-alt="县域经济智能决策支持系统受控工作流总体架构"
            aria-label="放大查看县域经济智能决策支持系统受控工作流总体架构"
            class="group block w-full cursor-zoom-in overflow-hidden rounded-2xl border border-blue-900/10 bg-[#031d43] text-left shadow-lg shadow-blue-950/10 transition-all hover:-translate-y-0.5 hover:shadow-xl"
          >
            <img
              src="https://img-asaakii-top.oss-cn-shanghai.aliyuncs.com/img/Codex%20%E5%9B%BE%E5%83%8F%202026%E5%B9%B49%E6%9C%8814%E6%97%A5%2000_31_17.webp"
              alt="县域经济智能决策支持系统受控工作流总体架构"
              width="1672"
              height="941"
              loading="lazy"
              class="block h-auto w-full transition-transform duration-500 group-hover:scale-[1.01]"
            />
          </button>
        </section>
      </FadeIn>
    )}

    <!-- Implementation Path (Case Study) -->
    {project.implementationPath && (
      <FadeIn delay={0.12}>
        <section id="implementation" data-page-section class="scroll-mt-28 mb-10">
          <SectionLabel text={project.implementationPath.title} />
          <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
            <p class="text-[13px] leading-relaxed text-gray-500">{project.implementationPath.subtitle}</p>
            <div class="flex items-center gap-2 text-[10px] text-gray-400">
              <span>点击步骤聚焦</span>
              <span data-path-status class="rounded-full bg-indigo-50 px-2 py-1 font-medium text-indigo-600">01 / {String(project.implementationPath.steps.length).padStart(2, '0')}</span>
            </div>
          </div>
          <div class="relative">
            <div class="absolute left-[15px] top-2 bottom-2 w-px bg-gradient-to-b from-indigo-300 via-indigo-200 to-indigo-100 sm:left-[19px]" />
            <div data-path-progress class="absolute left-[15px] top-2 h-0 w-px bg-indigo-500 transition-[height] duration-500 sm:left-[19px]" />
            <div class="space-y-4">
              {project.implementationPath.steps.map((step, i) => (
                <button type="button" data-path-step data-step-index={i} aria-current={i === 0 ? 'step' : undefined} class:list={['path-step relative flex w-full gap-4 text-left sm:gap-5', i === 0 && 'is-active']}>
                  <div data-path-index class="relative z-10 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full border-2 border-indigo-200 bg-white text-xs font-semibold text-indigo-600 shadow-sm transition-all sm:h-10 sm:w-10 sm:text-sm">
                    {String(i + 1).padStart(2, '0')}
                  </div>
                  <div data-path-card class="flex-1 rounded-xl border border-gray-200 bg-white px-5 py-4 shadow-sm transition-all hover:border-indigo-200 hover:shadow-md">
                    <h4 class="mb-1.5 text-[13px] font-semibold text-gray-900">{step.name}</h4>
                    <p class="text-[12px] leading-[1.7] text-gray-600">{step.description}</p>
                  </div>
                </button>
              ))}
            </div>
          </div>
        </section>
      </FadeIn>
    )}

    <!-- Runtime Case: one concrete request through the Agent Runtime -->
    {project.runtimeCase && (
      <FadeIn delay={0.14}>
        <section id="runtime-case" data-page-section data-runtime-case class="scroll-mt-28 mb-10 overflow-hidden rounded-2xl bg-slate-950 text-white shadow-xl shadow-slate-200/60">
          <div class="border-b border-white/10 px-6 py-6 md:px-8">
            <div class="mb-2 text-[10px] uppercase tracking-[2px] text-cyan-300/70">Runtime Case</div>
            <div class="flex flex-wrap items-end justify-between gap-4">
              <div>
                <h3 class="text-lg font-medium text-white">{project.runtimeCase.title}</h3>
                <p class="mt-1 max-w-2xl text-[12px] leading-relaxed text-slate-400">{project.runtimeCase.subtitle}</p>
              </div>
              <span data-runtime-status class="rounded-full border border-cyan-300/20 bg-cyan-300/10 px-3 py-1 text-[10px] font-medium text-cyan-200">
                01 / {String(project.runtimeCase.steps.length).padStart(2, '0')}
              </span>
            </div>
            <div class="mt-5 grid grid-cols-2 gap-2 md:grid-cols-4">
              {project.runtimeCase.input.map((item) => (
                <div class="rounded-lg border border-white/10 bg-white/[0.04] px-3 py-2.5">
                  <div class="text-[9px] uppercase tracking-wider text-slate-500">{item.label}</div>
                  <div class="mt-1 text-[11px] font-medium text-slate-200">{item.value}</div>
                </div>
              ))}
            </div>
          </div>

          <div class="px-6 py-6 md:px-8 md:py-8">
            <div class="relative mb-6 grid grid-cols-3 gap-2 md:grid-cols-6 md:gap-3">
              <div class="absolute left-[7%] right-[7%] top-4 hidden h-px bg-white/10 md:block" />
              <div data-runtime-progress class="absolute left-[7%] top-4 hidden h-px bg-cyan-300 transition-[width] duration-500 md:block" style="width: 0%" />
              {project.runtimeCase.steps.map((step, i) => (
                <button
                  type="button"
                  data-runtime-step
                  data-step-index={i}
                  data-step-name={step.name}
                  data-step-tool={step.tool}
                  data-step-description={step.description}
                  data-step-result={step.result}
                  aria-current={i === 0 ? 'step' : undefined}
                  class:list={['runtime-step group relative z-10 text-center', i === 0 && 'is-active']}
                >
                  <span data-runtime-index class="mx-auto flex h-8 w-8 items-center justify-center rounded-full border border-white/15 bg-slate-900 text-[10px] font-semibold text-slate-400 transition-all">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="mt-2 block text-[10px] leading-tight text-slate-400 transition-colors group-hover:text-white">{step.name}</span>
                </button>
              ))}
            </div>

            <div class="grid gap-4 rounded-xl border border-white/10 bg-white/[0.04] p-5 md:grid-cols-[1fr_1.25fr] md:p-6">
              <div>
                <div class="mb-2 flex flex-wrap items-center gap-2">
                  <span data-runtime-name class="text-sm font-semibold text-white">{project.runtimeCase.steps[0]?.name}</span>
                  <span data-runtime-tool class="rounded bg-cyan-300/10 px-2 py-0.5 font-mono text-[9px] text-cyan-200">{project.runtimeCase.steps[0]?.tool}</span>
                </div>
                <p data-runtime-description class="text-[12px] leading-[1.8] text-slate-300">{project.runtimeCase.steps[0]?.description}</p>
              </div>
              <div class="rounded-lg border border-emerald-300/10 bg-emerald-300/[0.06] px-4 py-3">
                <div class="mb-1 text-[9px] uppercase tracking-[1.5px] text-emerald-300/60">Stage Output</div>
                <p data-runtime-result class="text-[12px] leading-[1.7] text-emerald-100/90">{project.runtimeCase.steps[0]?.result}</p>
              </div>
            </div>
          </div>
        </section>
      </FadeIn>
    )}

    <hr class="border-gray-100" />

    <!-- Data Foundation -->
    {project.dataAssets && project.dataAssets.length > 0 && (
      <FadeIn delay={0.12}>
        <section id="data-foundation" data-page-section class="scroll-mt-28 py-10">
          <SectionLabel text="Data Foundation" />
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {project.dataAssets.map((asset) => (
              <div class="rounded-xl border border-gray-200 bg-white px-5 py-4 shadow-sm transition-all hover:border-gray-300 hover:shadow-md">
                <div class="mb-1 text-[11px] font-medium uppercase tracking-wider text-gray-400">{asset.name}</div>
                <div data-asset-value data-target={asset.value} aria-label={asset.value} class="mb-2 text-xl font-light tabular-nums text-gray-900">{asset.value}</div>
                <p class="text-[12px] leading-[1.6] text-gray-500">{asset.description}</p>
              </div>
            ))}
          </div>
        </section>
      </FadeIn>
    )}

    <!-- Knowledge engineering and retrieval evidence -->
    {project.engineeringMethods && (
      <FadeIn delay={0.13}>
        <section id="engineering-methods" data-page-section class="scroll-mt-36 pb-10 pt-4">
          <SectionLabel text={project.engineeringMethods.title} />
          <p class="mb-6 max-w-3xl text-[13px] leading-[1.8] text-gray-500">{project.engineeringMethods.description}</p>
          <div class="grid gap-5 lg:grid-cols-[1.1fr_0.9fr]">
            <div class="grid gap-3 sm:grid-cols-2">
              {project.engineeringMethods.items.map((item, i) => (
                <div class="group rounded-xl border border-gray-200 bg-white px-5 py-4 shadow-sm transition-all hover:-translate-y-0.5 hover:border-cyan-200 hover:shadow-md">
                  <div class="mb-3 flex items-center justify-between">
                    <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-cyan-50 text-[10px] font-semibold text-cyan-700">{String(i + 1).padStart(2, '0')}</span>
                    <span class="h-px w-8 bg-cyan-100 transition-all group-hover:w-12 group-hover:bg-cyan-300" />
                  </div>
                  <h4 class="mb-1.5 text-[13px] font-semibold text-gray-900">{item.title}</h4>
                  <p class="text-[11px] leading-[1.75] text-gray-500">{item.description}</p>
                </div>
              ))}
            </div>
            <div class="rounded-2xl bg-gray-50 p-5 md:p-6">
              <div class="mb-4 text-[10px] uppercase tracking-[1.8px] text-gray-400">Optimization Evidence</div>
              <div class="space-y-3">
                {project.engineeringMethods.evidence.map((item) => (
                  <div class="rounded-xl border border-gray-200/80 bg-white px-4 py-3 shadow-sm">
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                      <span class="text-lg font-semibold tabular-nums text-gray-900">{item.value}</span>
                      <span class="text-[10px] font-medium text-cyan-700">{item.label}</span>
                    </div>
                    <p class="mt-1 text-[10px] leading-relaxed text-gray-400">{item.detail}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>
      </FadeIn>
    )}

    <!-- Three-layer deliverables -->
    {project.deliveryLayers && project.deliveryLayers.length > 0 && (
      <FadeIn delay={0.14}>
        <section class="pb-10">
          <SectionLabel text="Auditable Deliverables" />
          <div class="grid gap-3 md:grid-cols-3">
            {project.deliveryLayers.map((layer, i) => (
              <div class="relative overflow-hidden rounded-xl border border-indigo-100 bg-indigo-50/30 px-5 py-5 transition-all hover:border-indigo-200 hover:bg-indigo-50/60 hover:shadow-sm">
                <span class="absolute right-4 top-3 text-3xl font-light text-indigo-100">0{i + 1}</span>
                <div class="relative">
                  <h4 class="text-[13px] font-semibold text-gray-900">{layer.name}</h4>
                  <div class="mt-1 font-mono text-[9px] uppercase tracking-wider text-indigo-500">{layer.format}</div>
                  <p class="mt-3 text-[11px] leading-[1.7] text-gray-500">{layer.description}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      </FadeIn>
    )}

    <!-- Expert Roles -->
    {project.expertRoles && project.expertRoles.length > 0 && (
      <FadeIn delay={0.14}>
        <section id="expert-roles" data-page-section data-role-section class="scroll-mt-28 pb-10">
          <SectionLabel text="14 Expert Roles" />
          <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-gray-200 bg-white p-2 shadow-sm">
            <label class="flex min-w-[220px] flex-1 items-center gap-2 px-2">
              <span class="text-gray-300" aria-hidden="true">⌕</span>
              <span class="sr-only">搜索专家角色</span>
              <input data-role-search type="search" placeholder="搜索角色或职责…" class="w-full bg-transparent py-1.5 text-[12px] text-gray-700 outline-none placeholder:text-gray-300" />
            </label>
            <span data-role-count class="rounded-lg bg-gray-50 px-3 py-1.5 text-[10px] text-gray-500">{project.expertRoles.length} 个角色</span>
          </div>
          <div data-role-grid class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {project.expertRoles.map((role, i) => (
              <div data-role-card data-search-text={`${role.name} ${role.responsibility}`} class="group rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-sm transition-all hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-md">
                <div class="mb-0.5 flex items-center gap-2">
                  <span class="flex h-5 w-5 items-center justify-center rounded bg-indigo-100 text-[10px] font-medium text-indigo-600">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-[13px] font-semibold text-gray-900">{role.name}</span>
                </div>
                <div class="pl-7 text-[11px] leading-relaxed text-gray-500">{role.responsibility}</div>
              </div>
            ))}
          </div>
          <p data-role-empty class="hidden rounded-xl border border-dashed border-gray-200 py-8 text-center text-[12px] text-gray-400">没有匹配的专家角色</p>
        </section>
      </FadeIn>
    )}

    <hr class="border-gray-100" />

    <!-- Role + Tech Stack: side by side on desktop -->
    <FadeIn delay={0.1}>
      <section class="grid gap-8 py-10 md:grid-cols-5 md:gap-12">
        <div class="md:col-span-3">
          <SectionLabel text="My Role" />
          <p class="text-sm leading-[1.8] text-gray-700">
            {project.role}
          </p>
        </div>
        <div class="md:col-span-2">
          <SectionLabel text="Tech Stack" />
          <TechTags tags={project.techStack} />
        </div>
      </section>
    </FadeIn>

    <!-- Business Chains: visual evidence grid -->
    {project.businessChains && project.businessChains.length > 0 && (
      <>
        <hr class="border-gray-100" />
        <FadeIn delay={0.15}>
          <section class="py-10">
            <SectionLabel text="9 Business Chains" />
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 md:gap-3 lg:grid-cols-3">
