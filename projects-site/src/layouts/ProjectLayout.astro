    <script>
      const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
      const pageSections = Array.from(document.querySelectorAll<HTMLElement>('[data-page-section]'));
      const setActiveSection = (id: string) => {
        sectionLinks.forEach((link) => {
          const active = link.dataset.sectionLink === id;
          link.classList.toggle('is-active', active);
          if (active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };

      if ('IntersectionObserver' in window && sectionLinks.length > 0) {
        const sectionObserver = new IntersectionObserver((entries) => {
          const visible = entries.find((entry) => entry.isIntersecting);
          if (visible) setActiveSection(visible.target.id);
        }, { rootMargin: '-24% 0px -66% 0px' });
        pageSections.forEach((section) => sectionObserver.observe(section));
      }

      document.querySelectorAll<HTMLElement>('[data-path-step]').forEach((step) => {
        step.addEventListener('click', () => {
          const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-path-step]'));
          const index = Number(step.dataset.stepIndex || 0);
          steps.forEach((item) => {
            const active = item === step;
            item.classList.toggle('is-active', active);
            if (active) item.setAttribute('aria-current', 'step');
            else item.removeAttribute('aria-current');
          });
          const status = document.querySelector<HTMLElement>('[data-path-status]');
          const progress = document.querySelector<HTMLElement>('[data-path-progress]');
          if (status) status.textContent = `${String(index + 1).padStart(2, '0')} / ${String(steps.length).padStart(2, '0')}`;
          if (progress) progress.style.height = `${steps.length > 1 ? (index / (steps.length - 1)) * 100 : 0}%`;
        });
      });

      document.querySelectorAll<HTMLElement>('[data-runtime-case]').forEach((runtimeCase) => {
        const steps = Array.from(runtimeCase.querySelectorAll<HTMLButtonElement>('[data-runtime-step]'));
        const status = runtimeCase.querySelector<HTMLElement>('[data-runtime-status]');
        const progress = runtimeCase.querySelector<HTMLElement>('[data-runtime-progress]');
        const name = runtimeCase.querySelector<HTMLElement>('[data-runtime-name]');
        const tool = runtimeCase.querySelector<HTMLElement>('[data-runtime-tool]');
        const description = runtimeCase.querySelector<HTMLElement>('[data-runtime-description]');
        const result = runtimeCase.querySelector<HTMLElement>('[data-runtime-result]');

        const selectStep = (selected: HTMLButtonElement) => {
          const index = Number(selected.dataset.stepIndex || 0);
          steps.forEach((step) => {
            const active = step === selected;
            step.classList.toggle('is-active', active);
            if (active) step.setAttribute('aria-current', 'step');
            else step.removeAttribute('aria-current');
          });
          if (status) status.textContent = `${String(index + 1).padStart(2, '0')} / ${String(steps.length).padStart(2, '0')}`;
          if (progress) progress.style.width = `${steps.length > 1 ? (index / (steps.length - 1)) * 86 : 0}%`;
          if (name) name.textContent = selected.dataset.stepName || '';
          if (tool) tool.textContent = selected.dataset.stepTool || '';
          if (description) description.textContent = selected.dataset.stepDescription || '';
          if (result) result.textContent = selected.dataset.stepResult || '';
        };

        steps.forEach((step) => step.addEventListener('click', () => selectStep(step)));
      });

      document.querySelectorAll<HTMLElement>('[data-role-section]').forEach((section) => {
        const input = section.querySelector<HTMLInputElement>('[data-role-search]');
        const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-role-card]'));
        const count = section.querySelector<HTMLElement>('[data-role-count]');
        const empty = section.querySelector<HTMLElement>('[data-role-empty]');
        input?.addEventListener('input', () => {
          const query = input.value.trim().toLocaleLowerCase('zh-CN');
          let visibleCount = 0;
          cards.forEach((card) => {
            const matches = !query || (card.dataset.searchText || '').toLocaleLowerCase('zh-CN').includes(query);
            card.hidden = !matches;
            if (matches) visibleCount += 1;
          });
          if (count) count.textContent = `${visibleCount} 个角色`;
          if (empty) empty.classList.toggle('hidden', visibleCount !== 0);
        });
      });

      const assetValues = Array.from(document.querySelectorAll<HTMLElement>('[data-asset-value]'));
      const animateAssetValue = (element: HTMLElement) => {
        if (element.dataset.animated === 'true') return;
        element.dataset.animated = 'true';
        const targetText = element.dataset.target || '';
        const match = targetText.match(/^([^0-9]*)([\d,]+)(.*)$/);
        if (!match || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const [, prefix, numberText, suffix] = match;
        const target = Number(numberText.replaceAll(',', ''));
        const usesGrouping = numberText.includes(',');
        const start = performance.now();
        const tick = (now: number) => {
          const progress = Math.min((now - start) / 900, 1);
          const current = Math.round(target * (1 - Math.pow(1 - progress, 3)));
          const formatted = current.toLocaleString('en-US', { useGrouping: usesGrouping });
          element.textContent = `${prefix}${formatted}${suffix}`;
          if (progress < 1) requestAnimationFrame(tick);
          else element.textContent = targetText;
        };
        requestAnimationFrame(tick);
      };

      if ('IntersectionObserver' in window) {
        const assetObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateAssetValue(entry.target as HTMLElement);
              assetObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.5 });
        assetValues.forEach((value) => assetObserver.observe(value));
      } else {
        assetValues.forEach(animateAssetValue);
      }
    </script>

    <style is:global>
      .section-nav-link.is-active {
        background: rgb(31 41 55);
        color: white;
      }

      .path-step {
        opacity: 0.62;
        transition: opacity 240ms ease;
      }

      .path-step:hover,
      .path-step.is-active {
        opacity: 1;
      }

      .path-step.is-active [data-path-index] {
        border-color: rgb(99 102 241);
        background: rgb(99 102 241);
        color: white;
        box-shadow: 0 0 0 4px rgb(224 231 255);
      }

      .path-step.is-active [data-path-card] {
        border-color: rgb(199 210 254);
        background: rgb(238 242 255 / 0.45);
        box-shadow: 0 8px 24px rgb(15 23 42 / 0.08);
      }

      .runtime-step {
        opacity: 0.7;
        transition: opacity 220ms ease, transform 220ms ease;
      }

      .runtime-step:hover,
      .runtime-step.is-active {
        opacity: 1;
        transform: translateY(-2px);
      }

      .runtime-step.is-active [data-runtime-index] {
        border-color: rgb(103 232 249 / 0.8);
        background: rgb(8 145 178);
        color: white;
        box-shadow: 0 0 0 4px rgb(34 211 238 / 0.12), 0 0 18px rgb(34 211 238 / 0.2);
      }

      .runtime-step:focus-visible {
        border-radius: 0.5rem;
        outline: 2px solid rgb(103 232 249 / 0.7);
        outline-offset: 4px;
      }

      @media (prefers-reduced-motion: reduce) {
        .path-step,
        .runtime-step,
        [data-path-index],
        [data-path-card],
        [data-path-progress],
        [data-runtime-index],
        [data-runtime-progress] {
          transition: none !important;
        }
      }
    </style>

    <!-- Prev / Next -->
    <div class="flex items-center justify-between border-t border-gray-100 py-8">
      {
        prev ? (
          <a
            href={`/projects/${prev.slug}`}
            class="text-[11px] text-gray-400 transition hover:text-gray-900"
