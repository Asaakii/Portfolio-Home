---
import Layout from './Layout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import MetricsGrid from '../components/MetricsGrid.astro';
import TechTags from '../components/TechTags.astro';
import HeroPipeline from '../components/HeroPipeline.astro';
import FadeIn from '../components/FadeIn.tsx';
import { getProject, getAdjacentProjects } from '../data/projects';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const project = getProject(slug)!;
const { prev, next } = getAdjacentProjects(slug);

const pipelineSubtitles: Record<string, string> = {
  'county-agent': 'County Agent · 从资料接收到报告交付',
  'ai-assistant': 'RAG Pipeline · 从提问到溯源回答',
  'smart-platform': 'Integration · 从子系统到统一大屏',
  'data-collection': 'IoT Pipeline · 从设备到可视化',
};
---

<Layout title={`${project.title} — Asaakii`} showBack>
  <main class="mx-auto max-w-5xl px-6 md:px-10">

    <!-- Hero: 2-col on desktop, pipeline on right -->
    <FadeIn client:load>
      <section class="grid items-start gap-8 pb-10 pt-16 md:grid-cols-5 md:gap-12 md:pt-20">
        <div class="md:col-span-3">
          <div class="mb-3 text-[10px] uppercase tracking-[2px] text-gray-400">
            {project.company} · {project.period}
          </div>
          <h1 class="mb-5 text-2xl font-light leading-snug text-gray-900 md:text-3xl">
            {project.title}
          </h1>
          <p class="text-sm leading-[1.8] text-gray-600">
            {project.summary}
          </p>
        </div>
        <div class="md:col-span-2">
          <HeroPipeline nodes={project.architecture} subtitle={pipelineSubtitles[slug]} />
        </div>
      </section>
    </FadeIn>

    <!-- Metrics -->
    <FadeIn client:visible>
      <section class="pb-10">
        <MetricsGrid metrics={project.metrics} />
      </section>
    </FadeIn>

    <!-- Outcomes: right after metrics, prominent style -->
    {project.outcomes && project.outcomes.length > 0 && (
      <FadeIn client:visible delay={0.05}>
        <section class="mb-10 rounded-2xl bg-gray-50 px-6 py-6 md:px-8 md:py-8">
          <SectionLabel text="Project Outcomes" />
          <ul class="space-y-3">
            {project.outcomes.map((item) => (
              <li class="flex items-start gap-3 text-sm leading-[1.8] text-gray-700 [&_strong]:font-semibold [&_strong]:text-gray-900">
                <span class="mt-[10px] block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gray-400" />
                <span set:html={item} />
              </li>
            ))}
          </ul>
        </section>
      </FadeIn>
    )}

    <!-- Background -->
    {project.background && (
      <FadeIn client:visible delay={0.08}>
        <section class="pb-10">
          <SectionLabel text="Project Background" />
          <p class="max-w-3xl text-sm leading-[1.9] text-gray-700">
            {project.background}
          </p>
        </section>
      </FadeIn>
    )}

    <!-- Pain Points -->
    {project.painPoints && project.painPoints.length > 0 && (
      <FadeIn client:visible delay={0.1}>
        <section class="pb-10">
          <SectionLabel text="Core Challenges" />
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {project.painPoints.map((point) => (
              <div class="rounded-xl border border-red-100 bg-red-50/50 px-5 py-4 transition-all hover:border-red-200 hover:shadow-sm">
                <div class="mb-2 flex items-center gap-2">
                  <span class="flex h-6 w-6 items-center justify-center rounded-full bg-red-100 text-xs text-red-600">!</span>
                  <span class="text-[13px] font-semibold text-gray-900">{point.title}</span>
                </div>
                <p class="text-[12px] leading-[1.7] text-gray-600">{point.description}</p>
              </div>
            ))}
          </div>
        </section>
      </FadeIn>
    )}

    <!-- Solution Positioning -->
    {project.solutionPositioning && (
      <FadeIn client:visible delay={0.12}>
        <section class="mb-10 rounded-2xl border border-indigo-100 bg-indigo-50/40 px-6 py-6 md:px-8 md:py-8">
          <SectionLabel text="Solution & Positioning" />
          <p class="text-sm leading-[1.9] text-gray-700">{project.solutionPositioning}</p>
        </section>
      </FadeIn>
    )}

    <!-- Implementation Path (Case Study) -->
    {project.implementationPath && (
      <FadeIn client:visible delay={0.12}>
        <section class="mb-10">
          <SectionLabel text={project.implementationPath.title} />
          <p class="mb-6 text-[13px] leading-relaxed text-gray-500">{project.implementationPath.subtitle}</p>
          <div class="relative">
            <div class="absolute left-[15px] top-2 bottom-2 w-px bg-gradient-to-b from-indigo-300 via-indigo-200 to-indigo-100 sm:left-[19px]" />
            <div class="space-y-4">
              {project.implementationPath.steps.map((step, i) => (
                <div class="relative flex gap-4 sm:gap-5">
                  <div class="relative z-10 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full border-2 border-indigo-200 bg-white text-xs font-semibold text-indigo-600 shadow-sm sm:h-10 sm:w-10 sm:text-sm">
                    {String(i + 1).padStart(2, '0')}
                  </div>
                  <div class="flex-1 rounded-xl border border-gray-200 bg-white px-5 py-4 shadow-sm transition-all hover:border-indigo-200 hover:shadow-md">
                    <h4 class="mb-1.5 text-[13px] font-semibold text-gray-900">{step.name}</h4>
                    <p class="text-[12px] leading-[1.7] text-gray-600">{step.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      </FadeIn>
    )}

    <hr class="border-gray-100" />

    <!-- Data Foundation -->
    {project.dataAssets && project.dataAssets.length > 0 && (
      <FadeIn client:visible delay={0.12}>
        <section class="py-10">
          <SectionLabel text="Data Foundation" />
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {project.dataAssets.map((asset) => (
              <div class="rounded-xl border border-gray-200 bg-white px-5 py-4 shadow-sm transition-all hover:border-gray-300 hover:shadow-md">
                <div class="mb-1 text-[11px] font-medium uppercase tracking-wider text-gray-400">{asset.name}</div>
                <div class="mb-2 text-xl font-light text-gray-900">{asset.value}</div>
                <p class="text-[12px] leading-[1.6] text-gray-500">{asset.description}</p>
              </div>
            ))}
          </div>
        </section>
      </FadeIn>
    )}

    <!-- Expert Roles -->
    {project.expertRoles && project.expertRoles.length > 0 && (
      <FadeIn client:visible delay={0.14}>
        <section class="pb-10">
          <SectionLabel text="14 Expert Roles" />
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {project.expertRoles.map((role, i) => (
              <div class="group rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-sm transition-all hover:border-gray-300 hover:shadow-md">
                <div class="mb-0.5 flex items-center gap-2">
                  <span class="flex h-5 w-5 items-center justify-center rounded bg-indigo-100 text-[10px] font-medium text-indigo-600">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-[13px] font-semibold text-gray-900">{role.name}</span>
                </div>
                <div class="pl-7 text-[11px] leading-relaxed text-gray-500">{role.responsibility}</div>
              </div>
            ))}
          </div>
        </section>
      </FadeIn>
    )}

    <hr class="border-gray-100" />

    <!-- Role + Tech Stack: side by side on desktop -->
    <FadeIn client:visible delay={0.1}>
      <section class="grid gap-8 py-10 md:grid-cols-5 md:gap-12">
        <div class="md:col-span-3">
          <SectionLabel text="My Role" />
          <p class="text-sm leading-[1.8] text-gray-700">
            {project.role}
          </p>
        </div>
        <div class="md:col-span-2">
          <SectionLabel text="Tech Stack" />
          <TechTags tags={project.techStack} />
        </div>
      </section>
    </FadeIn>

    <!-- Business Chains: visual evidence grid -->
    {project.businessChains && project.businessChains.length > 0 && (
      <>
        <hr class="border-gray-100" />
        <FadeIn client:visible delay={0.15}>
          <section class="py-10">
            <SectionLabel text="9 Business Chains" />
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 md:gap-3 lg:grid-cols-3">
              {project.businessChains.map((chain, i) => (
                <div class="group rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-sm transition-all hover:border-gray-300 hover:shadow-md md:px-5 md:py-4">
                  <div class="mb-0.5 flex items-center gap-2 md:mb-1">
                    <span class="flex h-5 w-5 items-center justify-center rounded bg-gray-800 text-[10px] font-medium text-white">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="text-[13px] font-semibold text-gray-900">{chain.name}</span>
                  </div>
                  <div class="pl-7 text-[11px] text-gray-500">
                    → {chain.output}
                  </div>
                </div>
              ))}
            </div>
          </section>
        </FadeIn>
      </>
    )}

    <!-- Quality Gates: visual evidence matrix -->
    {project.qualityGates && project.qualityGates.length > 0 && (
      <FadeIn client:visible delay={0.18}>
        <section class="pb-10">
          <SectionLabel text="Quality Gates" />
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 md:gap-3 lg:grid-cols-3">
            {project.qualityGates.map((gate) => (
              <div class="rounded-xl border border-gray-200 bg-white px-4 py-2.5 shadow-sm transition-all hover:border-gray-300 hover:shadow-md md:px-5 md:py-4">
                <div class="mb-0.5 flex items-center gap-2 md:mb-1.5">
                  <span class="h-2 w-2 rounded-full bg-emerald-500" />
                  <span class="text-[13px] font-semibold text-gray-900">{gate.name}</span>
                </div>
                <div class="pl-4 text-[11px] leading-relaxed text-gray-500">
                  {gate.check}
                </div>
              </div>
            ))}
          </div>
        </section>
      </FadeIn>
    )}

    <!-- RAG Q&A Example (AI assistant only) -->
    {project.ragExample && (
      <FadeIn client:visible delay={0.15}>
        <section class="mb-10 rounded-2xl bg-gray-50 px-6 py-6 md:px-8 md:py-8">
          <SectionLabel text="RAG Q&A Example" />
          <div class="space-y-4">
            <div class="rounded-xl bg-blue-50 px-5 py-4">
              <div class="mb-1.5 text-[10px] font-semibold uppercase tracking-wider text-blue-500">Question</div>
              <p class="text-sm font-semibold text-gray-900">{project.ragExample.question}</p>
            </div>
            <div class="rounded-xl bg-white px-5 py-4 shadow-sm">
              <div class="mb-2 text-[10px] font-semibold uppercase tracking-wider text-gray-500">Retrieved Documents</div>
              <ul class="space-y-1.5">
                {project.ragExample.docs.map((doc) => (
                  <li class="flex items-start gap-2 text-[13px] text-gray-700">
                    <span class="mt-1.5 block h-1 w-1 flex-shrink-0 rounded-full bg-gray-500" />
                    {doc}
                  </li>
                ))}
              </ul>
            </div>
            <div class="rounded-xl bg-green-50 px-5 py-4">
              <div class="mb-1.5 text-[10px] font-semibold uppercase tracking-wider text-green-600">Answer</div>
              <p class="text-sm leading-[1.8] text-gray-900">{project.ragExample.answer}</p>
            </div>
            <div class="rounded-xl border border-gray-200 bg-white px-5 py-4 shadow-sm">
              <div class="mb-2 text-[10px] font-semibold uppercase tracking-wider text-gray-500">Sources</div>
              <ul class="space-y-1.5">
                {project.ragExample.sources.map((src) => (
                  <li class="flex items-start gap-2 text-[12px] text-gray-600">
                    <span class="mt-0.5">📄</span>
                    {src}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      </FadeIn>
    )}

    <!-- Subsystems Topology (smart-platform only) -->
    {project.subsystems && project.subsystems.length > 0 && (
      <>
        <hr class="border-gray-100" />
        <FadeIn client:visible delay={0.15}>
          <section class="py-10">
            <SectionLabel text="27 Subsystems Matrix" />
            <h4 class="mb-3 text-sm font-semibold text-gray-700">硬件子系统（17）</h4>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
              {project.subsystems.filter((sys) => sys.type === 'hardware').map((sys) => (
                <div class="rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-center shadow-sm transition-all hover:border-gray-300 hover:shadow-md">
                  <div class="text-[13px] font-medium text-gray-900">{sys.name}</div>
                  <div class="mt-0.5 text-[10px] text-gray-400">{sys.category}</div>
                </div>
              ))}
            </div>
            <h4 class="mb-3 mt-6 text-sm font-semibold text-gray-700">软件子系统（10）</h4>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
              {project.subsystems.filter((sys) => sys.type === 'software').map((sys) => (
                <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2.5 text-center shadow-sm transition-all hover:border-amber-300 hover:shadow-md">
                  <div class="text-[13px] font-medium text-gray-900">{sys.name}</div>
                  <div class="mt-0.5 text-[10px] text-amber-500">{sys.category}</div>
                </div>
              ))}
            </div>
          </section>
        </FadeIn>
      </>
    )}

    <!-- Screenshots Gallery -->
    {project.screenshots && project.screenshots.length > 0 && (
      <>
        <hr class="border-gray-100" />
        <FadeIn client:visible delay={0.15}>
          <section class="py-10">
            <SectionLabel text="Screenshots" />
            <div class="grid gap-4 md:grid-cols-2">
              {project.screenshots.map((shot) => (
                <button type="button" data-lightbox={shot.src} data-alt={shot.alt} class="group block w-full cursor-zoom-in overflow-hidden rounded-xl border border-gray-200 text-left shadow-sm transition-all hover:border-gray-300 hover:shadow-md">
                  <div class="aspect-[16/9] overflow-hidden bg-gray-100">
                    <img src={shot.src} alt={shot.alt} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" loading="lazy" />
                  </div>
                  <div class="bg-white px-4 py-2.5 text-center text-[13px] font-medium text-gray-700">{shot.alt}</div>
                </button>
              ))}
            </div>
            <div id="lightbox-overlay" class="fixed inset-0 z-50 hidden cursor-zoom-out items-center justify-center bg-black/80 backdrop-blur-sm" style="display:none;">
              <button type="button" id="lightbox-close" class="absolute right-5 top-5 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-2xl text-white transition-colors hover:bg-white/20">&times;</button>
              <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[92vw] rounded-lg object-contain shadow-2xl" />
              <div id="lightbox-caption" class="absolute bottom-6 left-1/2 -translate-x-1/2 rounded-full bg-black/60 px-5 py-2 text-sm text-white/90"></div>
            </div>
            <script>
              document.querySelectorAll('[data-lightbox]').forEach(btn => {
                btn.addEventListener('click', () => {
                  const overlay = document.getElementById('lightbox-overlay')!;
                  const img = document.getElementById('lightbox-img') as HTMLImageElement;
                  const caption = document.getElementById('lightbox-caption')!;
                  img.src = btn.getAttribute('data-lightbox')!;
                  img.alt = btn.getAttribute('data-alt') || '';
                  caption.textContent = btn.getAttribute('data-alt') || '';
                  overlay.style.display = 'flex';
                });
              });
              document.getElementById('lightbox-overlay')?.addEventListener('click', (e) => {
                if (e.target === e.currentTarget || (e.target as HTMLElement).id === 'lightbox-close') {
                  (e.currentTarget as HTMLElement).style.display = 'none';
                }
              });
              document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                  const overlay = document.getElementById('lightbox-overlay');
                  if (overlay) overlay.style.display = 'none';
                }
              });
            </script>
          </section>
        </FadeIn>
      </>
    )}

    <!-- Protocol Specs (data-collection only) -->
    {project.protocolSpecs && project.protocolSpecs.length > 0 && (
      <>
        <hr class="border-gray-100" />
        <FadeIn client:visible delay={0.15}>
          <section class="py-10">
            <SectionLabel text="Protocol Specs" />
            <div class="overflow-x-auto rounded-xl bg-gray-50 px-5 py-5 md:px-6 md:py-6">
              <table class="w-full text-left text-[13px]">
                <thead>
                  <tr class="border-b border-gray-200 text-[10px] font-semibold uppercase tracking-wider text-gray-500">
                    <th class="pb-3 pr-4 font-semibold">Protocol</th>
                    <th class="pb-3 pr-4 font-semibold">Medium</th>
                    <th class="pb-3 pr-4 font-semibold">Data Types</th>
                    <th class="pb-3 font-semibold">Use Case</th>
                  </tr>
                </thead>
                <tbody>
                  {project.protocolSpecs.map((spec) => (
                    <tr class="border-b border-gray-200/60">
                      <td class="py-3.5 pr-4 font-semibold text-gray-900">{spec.protocol}</td>
                      <td class="py-3.5 pr-4 text-gray-700">{spec.medium}</td>
                      <td class="py-3.5 pr-4 text-gray-700">{spec.dataTypes}</td>
                      <td class="py-3.5 text-gray-600">{spec.use}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        </FadeIn>
      </>
    )}

    <hr class="border-gray-100" />

    <!-- Highlights: cards with bullets + tags -->
    <FadeIn client:visible delay={0.2}>
      <section class="py-10">
        <SectionLabel text="Key Highlights" />
        <div class="grid gap-4 md:grid-cols-2">
          {
            project.highlights.map((h) => (
              <div class="rounded-xl border border-gray-200 bg-white px-5 py-5 shadow-sm transition-all hover:border-gray-300 hover:shadow-md">
                <h3 class="mb-1 text-sm font-semibold text-gray-900">
                  {h.title}
                </h3>
                {h.bullets && h.bullets.length > 0 ? (
                  <>
                    {h.description && (
                      <p class="mb-3 text-[12px] leading-relaxed text-indigo-500">{h.description}</p>
                    )}
                    <ul class="mb-3 space-y-2">
                      {h.bullets.map((b) => (
                        <li class="flex items-start gap-2 text-[13px] leading-[1.7] text-gray-700">
                          <span class="mt-[9px] block h-1 w-1 flex-shrink-0 rounded-full bg-gray-400" />
                          <span>{b}</span>
                        </li>
                      ))}
                    </ul>
                    {h.tags && h.tags.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 border-t border-gray-100 pt-3">
                        {h.tags.map((t) => (
                          <span class="rounded bg-gray-100 px-2 py-0.5 text-[10px] font-medium text-gray-500">
                            {t}
                          </span>
                        ))}
                      </div>
                    )}
                  </>
                ) : (
                  <p class="text-[13px] leading-[1.7] text-gray-700">
                    {h.description}
                  </p>
                )}
              </div>
            ))
          }
        </div>
      </section>
    </FadeIn>

    <!-- Core Differentiators -->
    {project.coreDifferentiators && project.coreDifferentiators.length > 0 && (
      <FadeIn client:visible delay={0.22}>
        <section class="pb-10">
          <SectionLabel text="Core Differentiators" />
          <div class="space-y-3">
            {project.coreDifferentiators.map((diff, i) => (
              <div class="flex gap-4 rounded-xl border border-gray-200 bg-white px-5 py-4 shadow-sm transition-all hover:border-indigo-200 hover:shadow-md">
                <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-sm font-semibold text-indigo-600">
                  {String(i + 1).padStart(2, '0')}
                </div>
                <div class="flex-1">
                  <h4 class="mb-1 text-[13px] font-semibold text-gray-900">{diff.title}</h4>
                  <p class="text-[12px] leading-[1.7] text-gray-600">{diff.description}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      </FadeIn>
    )}

    <!-- Reflection -->
    {project.reflection && (
      <FadeIn client:visible delay={0.22}>
        <section class="py-10">
          <SectionLabel text="Reflection & Takeaways" />
          <div class="rounded-2xl border border-amber-100 bg-amber-50/40 px-6 py-6 md:px-8 md:py-8">
            <p class="text-sm leading-[1.9] text-gray-700">{project.reflection}</p>
          </div>
        </section>
      </FadeIn>
    )}

    <!-- Outlook -->
    {project.outlook && project.outlook.length > 0 && (
      <FadeIn client:visible delay={0.24}>
        <section class="pb-10">
          <SectionLabel text="Future Outlook" />
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            {project.outlook.map((item, i) => (
              <div class="rounded-xl border border-emerald-100 bg-emerald-50/40 px-5 py-4 transition-all hover:border-emerald-200 hover:shadow-sm">
                <div class="mb-2 flex items-center gap-2">
                  <span class="flex h-5 w-5 items-center justify-center rounded bg-emerald-100 text-[10px] font-medium text-emerald-600">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-[13px] font-semibold text-gray-900">{item.title}</span>
                </div>
                <p class="pl-7 text-[12px] leading-[1.7] text-gray-600">{item.description}</p>
              </div>
            ))}
          </div>
        </section>
      </FadeIn>
    )}

    <!-- Prev / Next -->
    <div class="flex items-center justify-between border-t border-gray-100 py-8">
      {
        prev ? (
          <a
            href={`/projects/${prev.slug}`}
            class="text-[11px] text-gray-400 transition hover:text-gray-900"
          >
            &larr; {prev.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a
            href={`/projects/${next.slug}`}
            class="text-[11px] text-gray-900 transition hover:text-gray-600"
          >
            {next.title} &rarr;
          </a>
        ) : (
          <span />
        )
      }
    </div>
  </main>
</Layout>
