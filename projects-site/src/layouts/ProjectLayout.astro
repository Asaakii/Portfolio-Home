        </FadeIn>
        <div id="lightbox-overlay" role="dialog" aria-modal="true" aria-label="图片放大预览" class="fixed inset-0 z-50 hidden cursor-zoom-out items-center justify-center bg-black/80 backdrop-blur-sm" style="display:none;">
          <button type="button" id="lightbox-close" aria-label="关闭图片预览" class="absolute right-5 top-5 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-2xl text-white transition-colors hover:bg-white/20">&times;</button>
          <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[92vw] rounded-lg object-contain shadow-2xl" />
          <div id="lightbox-caption" class="absolute bottom-6 left-1/2 -translate-x-1/2 rounded-full bg-black/60 px-5 py-2 text-sm text-white/90"></div>
