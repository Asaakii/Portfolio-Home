---
import Layout from '../layouts/Layout.astro';
import { getProject } from '../data/projects';
import { articles, chains, roles, chapterNames } from '../lib/county-whitepaper';
import { architectureLayers, nodeTypes, knowledgeCases, contextLayers, gates, qualityExamples, deliverySteps, engineeringTabs, asyncStates, workflowNarratives } from '../data/county-exhibit';
import '../styles/county-agent.css';
import 'katex/dist/katex.min.css';
const project = getProject('county-agent')!;
const navigation = [['origin', '项目原点'], ['architecture', '架构'], ['workflows', '业务链'], ['data', '数据与知识'], ['experts', '专家协同'], ['runtime', '运行时'], ['quality', '质量门禁'], ['pilot', '试点交付'], ['screenshots', '项目图片'], ['handbook', '技术手册']];
const groupNames = ['宏观与治理', '数据与量化监测', '产业诊断与招商', '规划策划与审查'];
const stats = [['9', '条业务链', '从数据治理到县域规划'], ['16', '个专家角色', '按工位装配，按权限执行'], ['6', '层质量门禁', '数字、证据与表达边界'], ['50+', '份试点产物', '白皮书记录的隆昌交付']];
const originalOverview = {
  src: 'https://img-asaakii-top.oss-cn-shanghai.aliyuncs.com/img/Codex%20%E5%9B%BE%E5%83%8F%202026%E5%B9%B49%E6%9C%8814%E6%97%A5%2000_30_57.webp',
  alt: '县域经济智能决策支撑平台总体工作流与底座支撑架构图',
};
const originalWorkflow = {
  src: 'https://img-asaakii-top.oss-cn-shanghai.aliyuncs.com/img/Codex%20%E5%9B%BE%E5%83%8F%202026%E5%B9%B49%E6%9C%8814%E6%97%A5%2000_31_17.webp',
  alt: '县域经济智能决策支持系统受控工作流总体架构',
};
const implementationImages = project.screenshots!;
const handbookStages = [
  { chapter: 1, tag: '01 业务原点', title: '需求定义与权力边界', desc: '183 县治理六大痛点、智能内核职责范围与法定审签权力边界' },
  { chapter: 2, tag: '02 架构与运行时', title: '双层解耦与状态机拓扑', desc: 'Hermes 平台宿主 + LangGraph 状态图、稳态超时治理与并发扇出' },
  { chapter: 3, tag: '03 数据与知识', title: '双通道底座与知识工程', desc: '硬指标 SQL 通道、Dify 专题知识库、GraphRAG 与五层上下文工程' },
  { chapter: 4, tag: '04 业务链流水线', title: '9 条全流程端到端编排', desc: '感知监测（4.1/4.2/4.8）→ 诊断归因（4.3/4.4/4.9）→ 决策落地（4.5/4.6/4.7）' },
  { chapter: 5, tag: '05 专家协同沙箱', title: '16 角色工位与代码硬护栏', desc: '宏观/数据/产业/规划 4 大专家组、Harness 代码硬拦截与沙箱物理隔离' },
  { chapter: 6, tag: '06 质量门禁与评测', title: '6 层拦截网与 CI/CD 评测', desc: '数字/证据/逻辑/结构/敏感/发布 6 道门禁、L1-L4 契约与四维自动化评测' },
  { chapter: 7, tag: '07 隆昌实战交付', title: '12 阶段落地与 50+ 资产', desc: '隆昌 510283 端到端实战验证、30min 初稿流水线与规划送审稿交付' },
  { chapter: 8, tag: '08 生产就绪复盘', title: '5 维验收与循环可观测', desc: '业务确定性认知、数据工程基石、生产就绪 Checklist 与收敛度量' },
];
---
<Layout title="县域经济智能内核 · 从资料到决策 — Asaakii" showBack>
  <main class="county-page">
    <div class="reading-progress" aria-hidden="true"><span></span></div>
    <section class="county-hero wrap" id="overview">
      <div class="hero-copy">
        <a class="back-link" href="/projects/">↖ 返回项目集</a>
        <p class="eyebrow"><span class="status-dot"></span> CASE STUDY 01 / GOVTECH × AGENT ENGINEERING</p>
        <h1>把县域资料，<br />变成<span class="hero-emphasis">有据可查</span><br />的决策初稿<span class="title-dot">。</span></h1>
        <p class="hero-description">县域经济智能分析与协同决策平台<br /><strong>从零构建一个能分析、能协同、能交付的 AI 智能内核。</strong></p>
        <p class="hero-detail">用确定性工作流组织复杂业务，用受控智能体理解资料，让每个数字、每条政策和每份送审稿都有来处。</p>
        <div class="hero-actions"><a class="button primary" href="#architecture">探索系统架构 <span>↗</span></a><a class="button quiet" href="#pilot">看隆昌交付 <span>↓</span></a><a class="button quiet" href="#screenshots">项目图片 <span>↗</span></a></div>
        <div class="hero-meta"><span>{project.company}</span><span>{project.period}</span><span>架构设计 / 智能内核开发</span></div>
        <button class="motion-toggle" id="county-motion-toggle" aria-pressed="false">暂停动效 <span aria-hidden="true">Ⅱ</span></button>
      </div>
      <div class="hero-blueprint" aria-label="智能内核架构示意">
        <div class="blueprint-top"><span><i></i> COUNTY INTELLIGENCE ENGINE</span><span>SYS. 510283</span></div>
        <div class="blueprint-grid">
          <div class="blueprint-input"><span class="micro-label">01 / INPUT</span><strong>统计数据 <span>+</span> 政策资料</strong><small>把杂乱材料变成可用证据</small></div>
          <div class="blueprint-link">↓ <span>VERIFIED EVIDENCE</span></div>
          <a class="blueprint-engine" href="#architecture"><div class="engine-orbit" aria-hidden="true"><span></span><span></span><span></span><b>◎</b></div><div><span class="micro-label">02 / CONTROLLED INTELLIGENCE</span><strong>工作流骨架 × 智能体</strong><small>Hermes Host + LangGraph Runtime</small></div><span class="blueprint-plus">↗</span></a>
          <div class="blueprint-branches"><span>9 条流程</span><span>16 个角色</span><span>6 层门禁</span></div>
          <div class="blueprint-link">↓ <span>TRACEABLE ARTIFACTS</span></div>
          <div class="blueprint-output"><span class="paper-icon">▤</span><div><span class="micro-label">03 / DELIVERY</span><strong>报告 · 行动矩阵 · 送审稿</strong></div><span class="file-types">MD<br />JSON<br />DOCX</span></div>
        </div>
        <div class="blueprint-bottom"><span>代码控制边界 · 模型理解与表达</span><span>ENGINEERING, WITH EVIDENCE.</span></div>
      </div>
    </section>
    <div class="metric-strip wrap">{stats.map(([value, label, note]) => <div><strong>{value}<span>{label}</span></strong><p>{note}</p></div>)}</div>
    <section class="overview-image wrap" aria-label="平台总体架构原图">
      <figure class="original-figure"><a href={originalOverview.src} data-project-image target="_blank" rel="noopener noreferrer" aria-label={`放大查看：${originalOverview.alt}`}><img src={originalOverview.src} alt={originalOverview.alt} width="1672" height="941" loading="eager" fetchpriority="high" /><span class="image-enlarge">放大查看 ↗</span></a><figcaption><span class="micro-label">PLATFORM OVERVIEW</span><h3>平台总体工作流与底座支撑</h3><p>原页面的总体架构图。下方可继续探索各层职责与业务链。</p></figcaption></figure>
    </section>
    <nav class="chapter-nav" aria-label="项目章节"><div class="wrap">{navigation.map(([id, label], i) => <a href={`#${id}`} data-chapter-link={id}><span>{String(i + 1).padStart(2, '0')}</span>{label}</a>)}</div></nav>

    <section class="exhibit-section wrap" id="origin" data-chapter>
      <div class="section-heading"><p class="eyebrow">01 / THE PROBLEM</p><h2>真正要解决的，<br />是资料与决策之间的距离。</h2><p>县域分析不缺材料。难的是把不同年份、不同口径、不同部门的材料，连成可以复核、可以行动的判断。</p></div>
      <div class="origin-layout"><div class="origin-statement"><span class="micro-label">PROJECT CONTEXT</span><strong>183<span>个县（市、区）</span></strong><p>整体平台面向四川全省县域。白皮书记录总投资概算约 <b>2,682 万元</b>；这里展示的是其中的 AI 智能内核设计与隆昌试点。</p><div class="inline-note">183 县是建设覆盖范围；本页不据此声称全省已全部上线。</div></div><div class="pain-grid">{[
        ['底数不清', '约 20 项宏观指标的传统监测，难以刻画产业与要素结构；材料描述人工校核需 1–3 个月。'],
        ['研判不准', '经验难以支撑产业错位判断。立项材料提到 61.2% 县域主导产业集中于传统赛道。'],
        ['协同不畅', '15 项监管事项涉及 12 类数据、18 个省级部门；取数、补数和责任确认分散在不同系统。'],
        ['政策不精', '材料记录每年 200 余项政策，约 1/3 有跟踪；事前推演、执行监测与事后评估需要连接。'],
        ['决策滞后', '清洗、校核、研究、统稿反复接力，资料成为报告时，经济情况可能已经变化。'],
        ['基层负担重', '同一指标多头填报、重复报送、口径冲突，耗费业务人员的时间。'],
      ].map(([title, text], i) => <article><span>0{i + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div>
      <p class="source-note">背景数字据项目白皮书中的立项材料描述，未附独立统计出处。<a href="#topic-1-1" data-topic-link>查看原文口径 ↗</a></p>
      <div class="mission-grid">{[['监测分析', '人工填报 / 静态排名', '多源归集 → 动态预警 → 态势研判'], ['错位发展', '经验判断 / 模板规划', '比较优势 → 产业断点 → 一县一策'], ['政策与项目', '事后总结 / 分散落实', '政策匹配 → 条件核验 → 协同行动']].map(([title, from, to]) => <article><span class="micro-label">BUSINESS TRANSFORMATION</span><h3>{title}</h3><p>{from}</p><span class="transform-arrow">↓</span><strong>{to}</strong></article>)}</div>
      <div class="boundary-bar"><span>决策辅助的边界</span><p>法定统计口径由主管部门确认；正式排名、风险定性与因果结论需要对应程序；规划和政策建议保留专家评审、行政审签。</p></div>
      <div class="build-story"><div><p class="eyebrow">FROM ZERO TO ONE</p><h3>我负责把研究流程，<br />变成可以运行的系统。</h3><p>从状态建模、业务编排到数据知识底座，再到角色权限、质量审查和试点文件交付。模型调用只是链路中的一个环节。</p></div><ol>{[['原型探索', '用 OpenClaw 验证角色与工具，发现长链路控制和状态管理的不足。'], ['架构迁移', '拆分 Hermes 宿主与 LangGraph 运行时，统一 MCP 工具协议。'], ['底座建设', '清洗年鉴与企业数据，解析政策材料，建立知识索引与证据契约。'], ['闭环交付', '固化 9 链、16 角色与 6 门禁，在隆昌验证从资料到 Word 送审稿。']].map(([title, text], i) => <li><span>0{i + 1}</span><div><h4>{title}</h4><p>{text}</p></div></li>)}</ol></div>
    </section>

    <section class="exhibit-section architecture-section" id="architecture" data-chapter>
      <div class="wrap"><div class="section-heading"><p class="eyebrow">02 / SYSTEM ARCHITECTURE</p><h2>一套系统，<br />五层分工。</h2><p>点击任意一层，查看它掌握的控制权，以及它向下一层交付什么。</p></div>
      <div class="architecture-workbench interactive-panel" data-switcher="architecture">
        <div class="architecture-canvas"><div class="exhibit-player architecture-player" data-player="architecture"><button type="button" data-play aria-pressed="false">▶ 播放分层导览</button><span data-player-status role="status">点击分层，或跟随一次任务流转</span></div><div class="canvas-caption"><span>ARCHITECTURE MAP</span><span>↓ 任务下行 · 证据回传 ↑</span></div>{architectureLayers.map((layer, i) => <button class:list={['arch-layer', i === 2 && 'selected']} data-choice={i} aria-pressed={i === 2}><span class="layer-number">0{i + 1}</span><div><span class="micro-label">{layer.en}</span><h3>{layer.name}</h3><div class="layer-chips">{layer.items.map(item => <span>{item}</span>)}</div></div><span class="layer-arrow">↗</span></button>)}</div>
        <div class="architecture-inspector">{architectureLayers.map((layer, i) => <div data-panel={i} hidden={i !== 2}><span class="pill">{layer.tag}</span><p class="inspector-index">LAYER 0{i + 1} / 05</p><h3>{layer.title}</h3><p>{layer.description}</p><div class="inspector-responsibility"><span class="micro-label">CONTROL & RESPONSIBILITY</span><strong>{layer.responsibility}</strong></div><a class="text-link" href={`#topic-${layer.topic}`} data-topic-link>深入这层的实现细节 ↗</a></div>)}<div class="architecture-legend"><span><i class="legend-code"></i>确定性代码</span><span><i class="legend-model"></i>受控模型节点</span><span><i class="legend-data"></i>事实与知识</span></div></div>
      </div>
      <div class="dual-loop"><div><span class="micro-label">OUTER / 工作流掌握全局顺序</span><div class="outer-steps"><span>数据治理</span><b>→</b><span>运行监测</span><b>→</b><span class="active">产业诊断</span><b>→</b><span>瓶颈归因</span></div></div><div class="inner-loop"><span class="micro-label">INNER / 节点内有限探索</span><div><span>组装上下文</span><b>→</b><span>模型决策</span><b>→</b><span>工具执行</span><b>→</b><span>观测与核验</span><b>↺</b></div><p>最多 6 轮工具探索 · 单次工具 20s 上限 · 证据缺口显式输出</p></div></div>
      <figure class="original-figure architecture-original"><a href={originalWorkflow.src} data-project-image target="_blank" rel="noopener noreferrer" aria-label={`放大查看：${originalWorkflow.alt}`}><img src={originalWorkflow.src} alt={originalWorkflow.alt} width="1672" height="941" loading="lazy" /><span class="image-enlarge">放大查看 ↗</span></a><figcaption><span class="micro-label">CONTROLLED WORKFLOW</span><h3>受控工作流总体架构</h3><p>原有架构图展示任务受理、业务路由、SQL / RAG 证据融合、质量门禁与多格式交付。</p></figcaption></figure>
      <div class="section-subheading"><h3>不是每个节点，都需要成为 Agent。</h3><p>按任务的确定性与探索需求，选择最小够用的执行方式。</p></div><div class="node-grid">{nodeTypes.map((node, i) => <article class={`node-card ${node.color}`}><span class="micro-label">0{i + 1} / {node.en}</span><h3>{node.name}</h3><strong>{node.question}</strong><p>{node.description}</p><code>{node.sample}</code><div>{node.control}</div></article>)}</div>
      </div>
    </section>

    <section class="exhibit-section wrap" id="workflows" data-chapter>
      <div class="section-heading"><p class="eyebrow">03 / BUSINESS WORKFLOWS</p><h2>九条业务链，<br />把问题变成可交付的产物。</h2><p>从“哪些数据能用”，到“如何形成规划”。每条链都有明确的输入、工具、门禁与人工复核条件。</p></div>
      <div class="workflow-workbench interactive-panel" data-switcher="workflows"><div class="workflow-menu" aria-label="选择业务链">{chains.map((chain, i) => <button class:list={[i === 0 && 'selected']} data-choice={i} aria-pressed={i === 0}><span>0{i + 1}</span><strong>{chain.name}</strong><span>↗</span></button>)}</div><div class="workflow-display">{chains.map((chain, i) => <article data-panel={i} hidden={i !== 0}><div class="workflow-title"><span class="pill">WORKFLOW 0{i + 1}</span><code>{chain.id}</code></div><h3>{chain.question}</h3><p>{chain.intro}</p><div class="workflow-walkthrough" data-player="workflow">
          <div class="workflow-flow" aria-label="选择流程步骤">{chain.steps.map((step, j) => <button type="button" data-walk-step={j} data-step-note={workflowNarratives[i][j]} aria-pressed={j === 0} class:list={[j === 0 && 'current']}><span>{String(j + 1).padStart(2, '0')}</span><strong>{step}</strong>{j < chain.steps.length - 1 && <b aria-hidden="true">→</b>}</button>)}</div>
          <div class="walkthrough-detail"><span data-walk-number>01 / 06</span><div><strong data-walk-title>{chain.steps[0]}</strong><p data-walk-note>{workflowNarratives[i][0]}</p></div></div>
          <div class="exhibit-player"><button type="button" data-play aria-pressed="false">▶ 播放这条业务链</button><button type="button" data-walk-reset aria-label="重置业务链演示">↺ 重置</button><span data-player-status role="status">本地流程演示 · 不执行实际任务</span></div>
          <div class="walkthrough-progress" aria-hidden="true"><span data-walk-progress style="--step-progress:16.6667%"></span></div>
        </div><div class="workflow-specs"><div><h4>输入契约</h4><p>{chain.input}</p></div><div><h4>参与角色</h4><p>{chain.roles}</p></div></div><div class="tool-row"><h4>授权工具</h4><div>{chain.tools.map(tool => <code>{tool}</code>)}</div></div><div class="artifact-row"><h4>交付产物</h4>{chain.outputs.map(file => <span><i>▤</i><code>{file}</code></span>)}</div><div class="review-note"><span>人工复核</span><p>{chain.review.replace(/^\w+（/, '（')}</p></div><a class="text-link" href={`#${chain.topic}`} data-topic-link>查看完整链路与流程图 ↗</a></article>)}</div></div>
      <div class="inline-note workflow-contract"><strong>共同的执行契约</strong><span>参数校验 → 角色分派 → 确定性工具 → 受控分析 → 质量审查 → 产物注册</span></div>
    </section>

    <section class="exhibit-section data-section" id="data" data-chapter><div class="wrap">
      <div class="section-heading"><p class="eyebrow">04 / DATA & KNOWLEDGE ENGINEERING</p><h2>让模型有事实可依，<br />从整理原料开始。</h2><p>数字与文本分开治理，再合成分析所需的证据。这也是从零构建中，最需要耐心的部分。</p></div>
      <div class="data-assets"><div><span class="micro-label">STRUCTURED DATA</span><strong>324,539<span>条年鉴记录</span></strong><p>1952—2024 年 · 925 地区 · 970 张标准表</p></div><div><span class="micro-label">ENTERPRISE REGISTRY</span><strong>22,119<span>家重点企业</span></strong><p>覆盖 21 个市州 · 登记 / 行业 / 经营范围</p></div><div><span class="micro-label">KNOWLEDGE CORPUS</span><strong>427<span>份核心文档</span></strong><p>12 个专题库 · 约 254 万字 · 隆昌库 136 份</p></div></div>
      <div class="dual-data interactive-panel" data-switcher="data"><div class="segmented" aria-label="切换数据通道"><button class="selected" data-choice="0" aria-pressed="true">硬指标 / PostgreSQL</button><button data-choice="1" aria-pressed="false">软知识 / Dify RAG</button></div><div class="data-demo" data-panel="0"><div><span class="micro-label">PRECISION FIRST</span><h3>“这个县的 GDP，取哪年的哪种口径？”</h3><p>数值通过参数化查询与视图聚合获得。记录字段必须携带年份、来源、单位和统计口径，缺失时创建补数任务。</p><div class="demo-tags"><span>精确查询</span><span>物理只读</span><span>范围鉴权</span></div></div><div class="query-card"><div><i></i> SQL QUERY / 结构示意</div><pre><code>SELECT metric_value, period, unit,
       statistical_scope, source_id
FROM authorized_metrics_view
WHERE county_code = :county_code
